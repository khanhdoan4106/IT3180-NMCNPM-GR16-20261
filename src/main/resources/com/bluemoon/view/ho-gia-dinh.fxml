<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- US-001: Quản lý hộ gia đình. -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.HoGiaDinhController"
      styleClass="trang">

    <Label text="Hộ gia đình" styleClass="tieu-de-trang"/>

    <Label fx:id="thongBaoLoi" styleClass="thong-bao-loi"
           wrapText="true" visible="false"/>
    <Label fx:id="thongBaoThanhCong" styleClass="thong-bao-thanh-cong"
           wrapText="true" visible="false"/>

    <Label text="Thêm hộ gia đình mới" styleClass="tieu-de-khung"/>

    <GridPane hgap="16" vgap="10">
        <Label text="Mã căn hộ *"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="oMaCanHo" promptText="VD: A-101"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Loại căn hộ *"
               GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <ComboBox fx:id="oLoaiCanHo" maxWidth="1.7976931348623157E308"
                  GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Tầng (1–30) *"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="oTang" promptText="VD: 5"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Diện tích (m²) *"
               GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="oDienTich" promptText="VD: 72,50"
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Tên chủ hộ *"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="oTenChuHo" promptText="Họ và tên chủ hộ"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Ngày sinh chủ hộ *"
               GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <DatePicker fx:id="oNgaySinhChuHo" maxWidth="1.7976931348623157E308"
                    GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Giới tính *"
               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="oGioiTinhChuHo" maxWidth="1.7976931348623157E308"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Số CCCD chủ hộ"
               GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="oCccdChuHo" promptText="12 chữ số"
                   GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <Label text="Số điện thoại"
               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="oSoDienThoai" promptText="Tùy chọn"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Ngày chuyển đến *"
               GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <DatePicker fx:id="oNgayChuyenDen" maxWidth="1.7976931348623157E308"
                    GridPane.rowIndex="4" GridPane.columnIndex="3"/>

        <Label text="Loại cư trú chủ hộ *"
               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="oLoaiCuTruChuHo" maxWidth="1.7976931348623157E308"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Nơi thường trú (tạm trú *)"
               GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <TextField fx:id="oNoiThuongTruChuHo"
                   GridPane.rowIndex="5" GridPane.columnIndex="3"/>

        <Label text="Tạm trú từ ngày (tạm trú *)"
               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <DatePicker fx:id="oTamTruTu" maxWidth="1.7976931348623157E308"
                    GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Đến ngày (tạm trú *)"
               GridPane.rowIndex="6" GridPane.columnIndex="2"/>
        <DatePicker fx:id="oTamTruDen" maxWidth="1.7976931348623157E308"
                    GridPane.rowIndex="6" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="12">
        <Button text="Thêm hộ gia đình" onAction="#themHo"
                styleClass="nut-chinh"/>
        <Button text="Nhập lại" onAction="#nhapLai"/>
    </HBox>

    <Label text="Danh sách hộ đang ở" styleClass="tieu-de-khung"/>

    <HBox spacing="12">
        <TextField fx:id="oTimKiem"
                   promptText="Tìm theo mã căn hộ hoặc tên chủ hộ..."
                   onKeyReleased="#timKiem" HBox.hgrow="ALWAYS"/>
        <Button text="Tải lại" onAction="#taiLai"/>
    </HBox>

    <TableView fx:id="bangHo" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label fx:id="bangHoTrong" text="Chưa có hộ nào đang ở."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="cotMaCanHo" text="Mã căn hộ"
                         prefWidth="110"/>
            <TableColumn fx:id="cotLoaiCanHo" text="Loại"
                         prefWidth="110"/>
            <TableColumn fx:id="cotTang" text="Tầng"
                         prefWidth="70"/>
            <TableColumn fx:id="cotDienTich" text="Diện tích"
                         prefWidth="130"/>
            <TableColumn fx:id="cotChuHo" text="Chủ hộ"
                         prefWidth="200"/>
            <TableColumn fx:id="cotSoDienThoai" text="Số điện thoại"
                         prefWidth="130"/>
            <TableColumn fx:id="cotSoThanhVien" text="Thành viên"
                         prefWidth="100"/>
            <TableColumn fx:id="cotNgayChuyenDen" text="Ngày chuyển đến"
                         prefWidth="140"/>
        </columns>
    </TableView>
</VBox>