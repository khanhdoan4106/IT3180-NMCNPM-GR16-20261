<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- TS-002: nhật ký chỉ đọc, không có nút sửa hoặc xóa. -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.NhatKyController"
      styleClass="trang" spacing="12">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Nhật ký thao tác" styleClass="tieu-de-trang"/>
        <Button text="Tải lại" onAction="#taiLai"/>
    </HBox>
    <Label fx:id="thongBaoLoi" styleClass="thong-bao-loi"
           wrapText="true" visible="false"/>
    <TableView fx:id="bangNhatKy" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Chưa có thao tác nào được ghi."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="cotThoiDiem" text="Thời điểm"
                         prefWidth="150"/>
            <TableColumn fx:id="cotNguoiDung" text="Người thực hiện"
                         prefWidth="130"/>
            <TableColumn fx:id="cotThaoTac" text="Thao tác"
                         prefWidth="160"/>
            <TableColumn fx:id="cotDoiTuong" text="Đối tượng"
                         prefWidth="150"/>
            <TableColumn fx:id="cotNoiDung" text="Nội dung thay đổi"
                         prefWidth="300"/>
        </columns>
    </TableView>
</VBox>
