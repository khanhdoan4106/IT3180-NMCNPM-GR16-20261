<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.TamTruTamVangController"
      styleClass="trang">

    <Label text="Quản lý Tạm trú, Tạm vắng" styleClass="tieu-de-trang"/>

    <Label fx:id="thongBaoLoi" styleClass="thong-bao-loi"
           wrapText="true" visible="false"/>
    <Label fx:id="thongBaoThanhCong" styleClass="thong-bao-thanh-cong"
           wrapText="true" visible="false"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Chọn hộ gia đình:" styleClass="chu-phu"/>
        <ComboBox fx:id="oHoGiaDinh" prefWidth="300"
                  promptText="Chọn mã hộ - tên chủ hộ..."/>
        <Button text="Tải lại DS Hộ" onAction="#taiLai"/>
    </HBox>

    <Label text="Thêm khai báo mới" styleClass="tieu-de-khung"/>

    <GridPane hgap="16" vgap="10">
        <Label text="Nhân khẩu *"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="oNhanKhau" prefWidth="250"
                  promptText="Chọn người trong hộ"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Loại *"
               GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <ComboBox fx:id="oLoaiKhaiBao" maxWidth="Infinity"
                  GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Số giấy tờ"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="oSoGiay" promptText="Sổ tạm trú..."
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Địa chỉ tạm vắng"
               GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="oDiaChiVang" promptText="Đến nơi nào..."
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Từ ngày *"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="oTuNgay" maxWidth="Infinity"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Đến ngày *"
               GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <DatePicker fx:id="oDenNgay" maxWidth="Infinity"
                    GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Lý do"
               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="oLyDo" promptText="Lý do khai báo"
                   GridPane.columnSpan="3"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="12">
        <Button text="Thêm khai báo" onAction="#themKhaiBao"
                styleClass="nut-chinh"/>
        <Button text="Nhập lại" onAction="#nhapLai"/>
    </HBox>

    <Label text="Lịch sử khai báo của hộ" styleClass="tieu-de-khung"/>

    <TableView fx:id="bang" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Vui lòng chọn một hộ gia đình ở trên."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="cotHoTen" text="Họ và tên" prefWidth="150"/>
            <TableColumn fx:id="cotCccd" text="Số CCCD" prefWidth="120"/>
            <TableColumn fx:id="cotLoai" text="Loại" prefWidth="90"/>
            <TableColumn fx:id="cotTuNgay" text="Từ ngày" prefWidth="110"/>
            <TableColumn fx:id="cotDenNgay" text="Đến ngày" prefWidth="110"/>
            <TableColumn fx:id="cotDiaChi" text="Nơi đến" prefWidth="150"/>
            <TableColumn fx:id="cotLyDo" text="Lý do" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>