<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.NhanKhauController"
      styleClass="trang">

    <Label text="Quản lý nhân khẩu" styleClass="tieu-de-trang"/>

    <Label fx:id="thongBaoLoi" styleClass="thong-bao-loi"
           wrapText="true" visible="false"/>
    <Label fx:id="thongBaoThanhCong" styleClass="thong-bao-thanh-cong"
           wrapText="true" visible="false"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Chọn hộ gia đình:" styleClass="chu-phu"/>
        <ComboBox fx:id="oHoGiaDinh" prefWidth="300"
                  promptText="Chọn mã hộ - tên chủ hộ..."/>
        <Button text="Tải lại DS Hộ" onAction="#taiLai"/>
    </HBox>

    <Label text="Thêm thành viên mới" styleClass="tieu-de-khung"/>

    <GridPane hgap="16" vgap="10">
        <Label text="Họ và tên *"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="oHoTen" promptText="Nguyễn Văn B"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Ngày sinh *"
                   GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <DatePicker fx:id="oNgaySinh" maxWidth="Infinity"
                    GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Giới tính *"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="oGioiTinh" maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Quan hệ với chủ hộ *"
                   GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <ComboBox fx:id="oQuanHe" maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Số CCCD"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="oCccd" promptText="12 chữ số"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Nghề nghiệp"
                   GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="oNgheNghiep"
                   GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Dân tộc"
               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="oDanToc" promptText="Tùy chọn"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Tôn giáo"
               GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="oTonGiao" promptText="Tùy chọn"
                   GridPane.rowIndex="3" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="12">
        <Button text="Thêm thành viên" onAction="#themNhanKhau"
                styleClass="nut-chinh"/>
        <Button text="Nhập lại" onAction="#nhapLai"/>
    </HBox>

    <Label text="Danh sách thành viên trong hộ" styleClass="tieu-de-khung"/>

    <TableView fx:id="bang" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Vui lòng chọn một hộ gia đình ở trên."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="cotHoTen" text="Họ và tên" prefWidth="200"/>
            <TableColumn fx:id="cotNgaySinh" text="Ngày sinh" prefWidth="120"/>
            <TableColumn fx:id="cotGioiTinh" text="Giới tính" prefWidth="90"/>
            <TableColumn fx:id="cotQuanHe" text="Quan hệ" prefWidth="120"/>
            <TableColumn fx:id="cotCccd" text="Số CCCD" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>