<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tab "Quản lý tài khoản" (US-022, giả định 18), chỉ Quản trị viên: danh
     sách tài khoản; với tài khoản đang chọn: đổi vai trò, khóa/mở khóa,
     đặt lại mật khẩu tạm. Không có nút xóa: tài khoản không bị xóa. -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.QuanLyTaiKhoanController"
      styleClass="khung">
    <Label text="Danh sách tài khoản" styleClass="tieu-de-khung"/>
    <TableView fx:id="bangTaiKhoan" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="cotTenDangNhap" text="Tên đăng nhập"
                         prefWidth="180"/>
            <TableColumn fx:id="cotHoTen" text="Họ tên" prefWidth="260"/>
            <TableColumn fx:id="cotVaiTro" text="Vai trò" prefWidth="160"/>
            <TableColumn fx:id="cotTrangThai" text="Trạng thái"
                         prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="dangChon" styleClass="chu-phu" wrapText="true"/>
    <FlowPane styleClass="hang-thao-tac">
        <HBox styleClass="hang-nut">
            <ComboBox fx:id="vaiTroMoi" promptText="Vai trò mới"
                      prefWidth="200"/>
            <Button fx:id="nutDoiVaiTro" text="Đổi vai trò"
                    onAction="#doiVaiTro"/>
        </HBox>
        <Button fx:id="nutKhoa" text="Khóa tài khoản"
                styleClass="nut-nguy-hiem" onAction="#khoaHoacMoKhoa"/>
        <Button fx:id="nutDatLaiMatKhau" text="Đặt lại mật khẩu"
                onAction="#datLaiMatKhau"/>
    </FlowPane>
    <Label fx:id="thongBao" wrapText="true" visible="false"/>
</VBox>
