<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Màn đăng nhập (US-021), 1120×645 theo ui.md. Ứng dụng mở lên là màn
     này; đăng nhập đúng mới vào cửa sổ chính.
     Bố cục và màu sẽ chỉnh theo thiết kế Figma (#70). -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bluemoon.controller.DangNhapController"
           styleClass="nen-dang-nhap">
    <VBox styleClass="khung, khung-dang-nhap" maxWidth="440"
          maxHeight="-Infinity">
        <VBox styleClass="dau-dang-nhap">
            <Label text="BlueMoon" styleClass="ten-ung-dung-lon"/>
            <Label text="Phần mềm quản lý chung cư" styleClass="chu-phu"/>
        </VBox>
        <Label text="Đăng nhập" styleClass="tieu-de-khung"/>

        <VBox styleClass="o-form">
            <Label text="Tên đăng nhập"/>
            <TextField fx:id="tenDangNhap"/>
            <Label fx:id="loiTenDangNhap" styleClass="thong-bao-loi"
                   wrapText="true" visible="false"/>
        </VBox>
        <VBox styleClass="o-form">
            <Label text="Mật khẩu"/>
            <PasswordField fx:id="matKhau"/>
            <Label fx:id="loiMatKhau" styleClass="thong-bao-loi"
                   wrapText="true" visible="false"/>
        </VBox>

        <Label fx:id="thongBao" styleClass="thong-bao-loi" wrapText="true"
               visible="false"/>
        <Button text="Đăng nhập" styleClass="nut-chinh" defaultButton="true"
                maxWidth="Infinity" onAction="#dangNhap"/>
    </VBox>
</StackPane>
