<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tab "Tạo tài khoản" của màn Tài khoản (US-020): Quản trị viên tạo
     tài khoản cho người dùng. Form dài: phần ô nhập cuộn được, thông báo
     và hàng nút luôn nhìn thấy ở cuối khung (ui.md). Bố cục sẽ chỉnh theo
     thiết kế Figma (#70). -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bluemoon.controller.TaiKhoanController"
      styleClass="khung" maxWidth="760" maxHeight="-Infinity">
    <Label text="Tạo tài khoản" styleClass="tieu-de-khung"/>
    <ScrollPane fx:id="cuonForm" styleClass="cuon-form" fitToWidth="true"
                hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <GridPane styleClass="luoi-form">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <VBox styleClass="o-form" GridPane.columnIndex="0"
                  GridPane.rowIndex="0">
                <Label text="Tên đăng nhập"/>
                <TextField fx:id="tenDangNhap" promptText="vd: thuquy01"/>
                <Label text="Chữ không dấu, chữ số, dấu chấm hoặc gạch dưới."
                       styleClass="chu-goi-y" wrapText="true"/>
                <Label fx:id="loiTenDangNhap" styleClass="thong-bao-loi"
                       wrapText="true" visible="false"/>
            </VBox>
            <VBox styleClass="o-form" GridPane.columnIndex="1"
                  GridPane.rowIndex="0">
                <Label text="Họ tên"/>
                <TextField fx:id="hoTen"/>
                <Label fx:id="loiHoTen" styleClass="thong-bao-loi"
                       wrapText="true" visible="false"/>
            </VBox>

            <VBox styleClass="o-form" GridPane.columnIndex="0"
                  GridPane.rowIndex="1">
                <Label text="Vai trò"/>
                <ComboBox fx:id="vaiTro" promptText="Chọn vai trò"
                          maxWidth="Infinity"/>
                <Label fx:id="loiVaiTro" styleClass="thong-bao-loi"
                       wrapText="true" visible="false"/>
            </VBox>

            <VBox styleClass="o-form" GridPane.columnIndex="0"
                  GridPane.rowIndex="2">
                <Label text="Mật khẩu"/>
                <PasswordField fx:id="matKhau"/>
                <Label fx:id="goiYMatKhau" styleClass="chu-goi-y"
                       wrapText="true"/>
                <Label fx:id="loiMatKhau" styleClass="thong-bao-loi"
                       wrapText="true" visible="false"/>
            </VBox>
            <VBox styleClass="o-form" GridPane.columnIndex="1"
                  GridPane.rowIndex="2">
                <Label text="Nhập lại mật khẩu"/>
                <PasswordField fx:id="nhapLai"/>
                <Label fx:id="loiNhapLai" styleClass="thong-bao-loi"
                       wrapText="true" visible="false"/>
            </VBox>
        </GridPane>
    </ScrollPane>
    <Label fx:id="thongBao" wrapText="true" visible="false"/>
    <HBox styleClass="hang-nut">
        <Button text="Tạo tài khoản" styleClass="nut-chinh"
                defaultButton="true" onAction="#taoTaiKhoan"/>
    </HBox>
</VBox>
