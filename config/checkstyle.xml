<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Kiem tu dong hai muc dinh dang cua docs/design/coding-convention.md:
  moi dong toi da 80 cot (dem theo ky tu, khong theo byte) va khong dung tab.
  Chay trong "mvn verify" cho ca src/main va src/test.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter"/>

    <!-- Dong package va import khong ngat duoc nen duoc bo qua (mac dinh). -->
    <module name="LineLength">
        <property name="max" value="80"/>
    </module>
</module>
